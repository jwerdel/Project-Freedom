# Normalize text line endings to LF in the repository (Godot's recommendation).
* text=auto eol=lf

# Windows scripts must keep CRLF to run correctly.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never diff or convert.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg text
*.exr binary
*.hdr binary
*.tga binary
*.bmp binary
*.ktx binary
*.ktx2 binary
*.dds binary
*.glb binary
*.gltf text
*.bin binary
*.fbx binary
*.blend binary
*.obj text
*.mtl text
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.res binary
*.scn binary
*.ctex binary
*.mesh binary
